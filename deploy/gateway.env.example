# Obscura Gateway configuration (KEY=VALUE).
# systemd install: /etc/obscura-gateway/gateway.env   Docker: ./config/gateway.env
# Tokens are managed with `obscura-gw add-token|revoke-token` and hot-reloaded.

# --- listening -----------------------------------------------------------------
# 127.0.0.1 = only this host (put a tunnel / reverse proxy in front for remote use).
# Use a Tailscale/VPN IP or 0.0.0.0 to accept direct connections (auth still applies).
OBSCURA_GW_HOST=127.0.0.1
OBSCURA_GW_PORT=8080
# URL your clients use; printed by `obscura-gw add-token` and baked into /setup.sh.
# Leave empty to derive it from the request's Host header.
OBSCURA_GW_PUBLIC_BASE=

# --- browsers -------------------------------------------------------------------
OBSCURA_IMAGE=h4ckf0r0day/obscura:0.2.3
# Docker network for browser containers; the egress firewall (deploy/firewall.sh)
# limits it to the public internet. Created by install.sh / docker compose.
OBSCURA_GW_NETWORK=obscura-net
OBSCURA_GW_MAXPOOL=25
OBSCURA_GW_MAX_PER_AGENT=5
OBSCURA_GW_IDLE=900
OBSCURA_GW_STEALTH=0
# Extra `docker run` options / obscura flags for every browser, e.g.
# OBSCURA_GW_DOCKER_ARGS=--memory 1g --pids-limit 512
OBSCURA_GW_DOCKER_ARGS=
OBSCURA_GW_OBSCURA_ARGS=

# --- PDF text extraction ------------------------------------------------------------
OBSCURA_GW_PDF_IMAGE=obscura-gw-pdftext:1

# --- diagnostics ----------------------------------------------------------------------
OBSCURA_GW_CRASH_DIR=/var/lib/obscura-gateway/crashes

# --- tokens (managed by obscura-gw; format token:name,token:name) ----------------------
OBSCURA_GW_TOKENS=
